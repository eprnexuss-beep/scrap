# ── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. Replace <db_username> with your Atlas database user.
# The database name (epr_nexuss_scrap) is created automatically on first write.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@scrap.nc0ipy8.mongodb.net/epr_nexuss_scrap?retryWrites=true&w=majority&appName=scrap

# ── Auth ────────────────────────────────────────────────────────────────────
# Long random string (32+ chars) used to sign login cookies.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4000
# Public URL of the FRONTEND (used in password-reset emails).
APP_URL=http://localhost:5173
# Serve the built frontend (../frontend/dist) from this server: one origin, simplest deployment.
SERVE_FRONTEND=false
# Extra origins allowed to POST/PATCH/DELETE (comma-separated). Rarely needed — only if a proxy rewrites the Host header.
CLIENT_URL=

# ── First admin account (used by: npm run seed:admin) ───────────────────────
ADMIN_EMAIL=admin@eprnexuss.com
ADMIN_PASSWORD=
ADMIN_NAME=EPR Nexuss Admin
ADMIN_COMPANY=EPR Nexuss
ADMIN_PHONE=

# ── Email (optional) ────────────────────────────────────────────────────────
# Leave SMTP_HOST empty in development: emails (e.g. password reset links) are printed in the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EPR Nexuss <no-reply@eprnexuss.com>
